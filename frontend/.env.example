# Copy to .env.local (gitignored) and fill in. Nothing here is required to run the app:
# without it the wallet picker simply lists the browser wallets it discovered over EIP-6963.

# WalletConnect / Reown project id — enables the "WalletConnect" entry in the wallet picker
# (QR code for phones, desktop wallet deep links). Free, takes a minute:
#   https://cloud.reown.com  ->  create a project  ->  copy the Project ID
# Leave unset and the option stays hidden. Never commit a real id.
VITE_WALLETCONNECT_PROJECT_ID=

# NAV-history collector JSONL (…/analytics/nav-history.jsonl) — the vault page's price chart draws its
# snapshots once a vault has 6 or more. Leave unset and the chart stays illustrative (badged).
VITE_NAV_HISTORY_URL=

# Team mode: SHA-256 (64 hex) of the team access code — unlocks the registry's staging vaults after
# 7 taps on the footer brand name. Unset = team mode off. Never commit a real hash.
VITE_GOLDEN_FINGER_SHA256=
